{
  "name": "kertas-kosong-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --test test/penilaian.test.mjs",
    "test:emulator": "npm run build && firebase emulators:exec --project demo-kertas-kosong --only auth,firestore,functions,storage \"node --test --test-concurrency=1 test/rules.test.mjs test/alur.test.mjs\"",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0",
    "typescript": "^6.0.0"
  }
}
