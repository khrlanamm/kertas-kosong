---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Halaman tidak ditemukan" noindex>
  <section class="garis-buku">
    <div class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center">
      <p class="text-7xl font-extrabold text-tinta-200">404</p>
      <h1 class="mt-4 text-3xl font-extrabold">Halaman ini masih kertas kosong</h1>
      <p class="mt-3 text-lg text-slate-600">Halaman yang kamu cari tidak ada atau sudah dipindahkan.</p>
      <a href="/" class="tombol-utama mt-8">Kembali ke beranda</a>
    </div>
  </section>
</BaseLayout>
