---
import AjakanTerlibat from "../components/AjakanTerlibat.astro";
import Foto from "../components/Foto.astro";
import Icon from "../components/Icon.astro";
import KegiatanCard from "../components/KegiatanCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import StatGrid from "../components/StatGrid.astro";
import { site } from "../config/site";
import { angkaBeranda } from "../data/dampak";
import { gerakan } from "../data/program";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getKegiatan } from "../lib/kegiatan";

const kegiatanTerbaru = (await getKegiatan()).slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="garis-buku relative overflow-hidden border-b border-tinta-100">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-14 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:py-20">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-tinta-200 bg-white px-3 py-1 text-sm font-medium text-tinta-700">
          <Icon name="Sparkles" class="size-4" />
          Gerakan sosial pendidikan sejak 2016
        </p>
        <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
          Membangun <span class="stabilo">Asa</span>, Menggapai <span class="stabilo">Cita</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">{site.description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/tentang" class="tombol-utama">Kenali Kami <Icon name="ArrowRight" class="size-4" /></a>
          <a href="/program" class="tombol-kedua">Lihat Program</a>
          <a href="/ayo-terlibat" class="tombol-kedua">Ayo Terlibat</a>
        </div>
        {
          site.links.portal && (
            <a href={site.links.portal} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-tinta-700 hover:text-tinta-900">
              Masuk ke Portal Bimbel <Icon name="ArrowRight" class="size-4" />
            </a>
          )
        }
      </div>
      <div class="relative">
        <div class="absolute -inset-4 -z-10 rotate-2 rounded-3xl bg-tinta-100"></div>
        <Foto
          src="seminar/seminar-2026-foto-bersama-aula.jpg"
          alt="Foto bersama peserta dan panitia Seminar Ayo Kuliah 2026 di aula SMAN 1 Dukun, Gresik"
          loading="eager"
          sizes="(min-width: 1024px) 45vw, 100vw"
          class="aspect-[4/3] w-full -rotate-1 rounded-2xl border-4 border-white object-cover shadow-xl"
        />
      </div>
    </div>
  </section>

  <!-- Angka -->
  <section class="mx-auto max-w-6xl px-4 pt-14 sm:px-6">
    <StatGrid items={angkaBeranda} />
    <p class="mt-3 text-xs text-slate-500">Angka bimbel dari Bimbel Ayo Kuliah 2026, kecuali disebut lain.</p>
  </section>

  <!-- Mengapa kami ada -->
  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2 lg:items-center">
    <div>
      <SectionHeading eyebrow="Mengapa kami ada" title="Setiap anak berhak mengubah masa depannya" />
      <p class="mt-5 text-lg leading-relaxed text-slate-600">
        Banyak siswa SMA dan SMK punya kemampuan akademik dan semangat belajar yang tinggi. Mimpi mereka sering terhenti
        karena biaya, minimnya informasi, dan tidak adanya pendampingan. Kami hadir supaya setiap anak punya kesempatan
        yang sama untuk mengubah masa depannya.
      </p>
      <a href="/tentang" class="tombol-kedua mt-8">Tentang Kami <Icon name="ArrowRight" class="size-4" /></a>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <Foto
        src="seminar/seminar-2026-peserta-menyimak.jpg"
        alt="Peserta Seminar Ayo Kuliah 2026 menyimak materi"
        sizes="(min-width: 1024px) 25vw, 50vw"
        widths={[400, 800]}
        class="aspect-[3/4] w-full rounded-2xl object-cover"
      />
      <div class="grid gap-3">
        <Foto
          src="bimbel/bimbel-2025-kelas-online-papan-tulis.jpg"
          alt="Tentor menjelaskan soal di kelas daring Bimbel 2025"
          sizes="(min-width: 1024px) 25vw, 50vw"
          widths={[400, 800]}
          class="aspect-[4/3] w-full rounded-2xl object-cover"
        />
        <Foto
          src="berbagi/paket-baju-2026.jpg"
          alt="Paket baju lebaran Ayo Berbagi 2026"
          sizes="(min-width: 1024px) 25vw, 50vw"
          widths={[400, 800]}
          class="aspect-[4/3] w-full rounded-2xl object-cover"
        />
      </div>
    </div>
  </section>

  <!-- #4AYO -->
  <section class="border-y border-tinta-100 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <SectionHeading eyebrow="Gerakan #4AYO" title="Empat gerakan, satu tujuan">
        Dimulai dari menumbuhkan minat baca, melatih kepenulisan kritis, mendampingi pendaftaran kuliah, hingga
        menciptakan siklus alumni yang saling memberdayakan.
      </SectionHeading>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          gerakan.map(({ slug, nama, ringkas, kartu }) => (
            <a
              href={`/program/${slug}`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-tinta-100 bg-kertas shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <Foto
                src={kartu}
                alt={`Gerakan ${nama}`}
                widths={[360, 720]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                class="aspect-square w-full object-cover"
              />
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-bold">{nama}</h3>
                <p class="mt-1.5 flex-1 text-sm text-slate-600">{ringkas}</p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-tinta-700">
                  Selengkapnya <Icon name="ArrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bimbel -->
  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[1fr_1.2fr] lg:items-center">
    <div>
      <SectionHeading eyebrow={site.bimbel.name} title="Bimbel gratis persiapan UTBK-SNBT" />
      <p class="mt-5 text-lg leading-relaxed text-slate-600">
        Sekitar lima minggu menjelang UTBK, tentor relawan dari berbagai kampus mengajar tujuh materi SNBT secara daring.
        Pada 2026, bimbel ini menjangkau <strong class="font-semibold text-slate-900">171 siswa dari 50 sekolah dan 15 kota</strong>,
        dan rerata skor tryout peserta naik 6 persen.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/bimbel" class="tombol-utama">Tentang bimbel <Icon name="ArrowRight" class="size-4" /></a>
        <a href="/bimbel#daftar" class="tombol-kedua">Cara mendaftar</a>
      </div>
    </div>
    <Foto
      src="bimbel/bimbel-2026-slide-jangkauan.jpg"
      alt="Slide jangkauan Bimbel Ayo Kuliah 2026: 171 siswa, 50 sekolah, 15 kota"
      sizes="(min-width: 1024px) 55vw, 100vw"
      class="w-full rounded-2xl border border-tinta-100 shadow-md"
    />
  </section>

  <!-- Kegiatan -->
  <section class="border-t border-tinta-100 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading eyebrow="Kegiatan" title="Kabar terbaru dari komunitas" />
        <a href="/kegiatan" class="tombol-kedua">Semua kegiatan <Icon name="ArrowRight" class="size-4" /></a>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {kegiatanTerbaru.map((kegiatan) => <KegiatanCard kegiatan={kegiatan} />)}
      </div>
    </div>
  </section>

  <AjakanTerlibat />
</BaseLayout>
