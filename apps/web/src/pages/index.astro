---
import { Image } from "astro:assets";
import kertas from "../assets/kertas.png";
import Icon from "../components/Icon.astro";
import KegiatanCard from "../components/KegiatanCard.astro";
import PortalSegera from "../components/PortalSegera.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getKegiatan } from "../lib/kegiatan";

const kegiatanTerbaru = (await getKegiatan()).slice(0, 3);

const program = [
  {
    icon: "BookOpen",
    title: site.bimbel.name,
    text: "Kelas per subtes setiap minggu, gratis, untuk kamu yang sedang bersiap masuk perguruan tinggi.",
    href: "/bimbel",
    cta: "Lihat program",
  },
  {
    icon: "Timer",
    title: "Tryout",
    text: "Latihan dengan suasana ujian sungguhan, biasanya dua kali setahun di bulan Maret dan Mei.",
    href: "/bimbel#tryout",
    cta: "Tentang tryout",
  },
  {
    icon: "Presentation",
    title: "Seminar & kegiatan",
    text: "Seminar dan acara komunitas untuk membuka wawasan seputar kuliah dan masa depan.",
    href: "/kegiatan",
    cta: "Lihat kegiatan",
  },
] as const;

const langkah = [
  { title: "Daftar", text: "Isi formulir pendaftaran saat angkatan baru dibuka." },
  { title: "Ikuti kelas", text: "Belajar per subtes bersama pengajar dan teman satu kelas." },
  { title: "Kerjakan tryout", text: "Ukur kesiapanmu dan temukan bagian yang perlu dilatih lagi." },
  { title: "Melangkah ke kampus", text: "Datang ke hari ujian dengan lebih siap dan percaya diri." },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="garis-buku relative overflow-hidden border-b border-tinta-100">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 md:grid-cols-[1.25fr_1fr] md:py-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-tinta-200 bg-white px-3 py-1 text-sm font-medium text-tinta-700">
          <Icon name="Sparkles" class="size-4" />
          {site.bimbel.name} &middot; gratis
        </p>
        <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
          Mulai dari <span class="stabilo">kertas kosong</span>, melangkah ke kampus impian.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
          {site.name} menyelenggarakan bimbingan belajar gratis untuk persiapan masuk perguruan tinggi,
          lengkap dengan kelas, rekaman, tryout, dan seminar.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/bimbel" class="tombol-utama">
            Lihat {site.bimbel.name} <Icon name="ArrowRight" class="size-4" />
          </a>
          <a href="/tentang" class="tombol-kedua">Kenali komunitas</a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-sm md:max-w-none">
        <div class="absolute -inset-6 -z-10 rounded-full bg-tinta-100/60 blur-3xl"></div>
        <Image src={kertas} alt="" width={720} loading="eager" class="h-auto w-full -rotate-3 drop-shadow-xl" />
      </div>
    </div>
  </section>

  <!-- Program -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <SectionHeading eyebrow="Program" title="Yang kami jalankan">
      Semua program terbuka gratis. Kami percaya kesempatan belajar tidak boleh bergantung pada biaya.
    </SectionHeading>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        program.map(({ icon, title, text, href, cta }) => (
          <a
            href={href}
            class="group flex flex-col rounded-2xl border border-tinta-100 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-tinta-200 hover:shadow-md"
          >
            <span class="grid size-12 place-items-center rounded-xl bg-tinta-50 text-tinta-600">
              <Icon name={icon} class="size-6" />
            </span>
            <h3 class="mt-5 text-xl font-bold">{title}</h3>
            <p class="mt-2 flex-1 text-slate-600">{text}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-tinta-700">
              {cta}
              <Icon name="ArrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Alur -->
  <section class="border-y border-tinta-100 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <SectionHeading eyebrow="Alur bimbel" title="Dari pendaftaran sampai hari ujian" />
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          langkah.map(({ title, text }, i) => (
            <li class="relative rounded-2xl border border-dashed border-tinta-200 bg-kertas p-6">
              <span class="text-4xl font-extrabold text-tinta-200">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-3 text-lg font-bold">{title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Kegiatan -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="Kegiatan" title="Kabar terbaru dari komunitas" />
      {
        kegiatanTerbaru.length > 0 && (
          <a href="/kegiatan" class="tombol-kedua">
            Semua kegiatan <Icon name="ArrowRight" class="size-4" />
          </a>
        )
      }
    </div>
    {
      kegiatanTerbaru.length > 0 ? (
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {kegiatanTerbaru.map((kegiatan) => (
            <KegiatanCard kegiatan={kegiatan} />
          ))}
        </div>
      ) : (
        <p class="mt-8 rounded-2xl border border-dashed border-tinta-200 bg-white p-8 text-center text-slate-600">
          Belum ada kegiatan yang diumumkan. Pantau media sosial kami untuk kabar terbaru.
        </p>
      )
    }
  </section>

  <PortalSegera />
</BaseLayout>
