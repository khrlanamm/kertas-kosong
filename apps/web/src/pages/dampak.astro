---
import AjakanTerlibat from "../components/AjakanTerlibat.astro";
import Foto from "../components/Foto.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import { capaian } from "../data/dampak";
import BaseLayout from "../layouts/BaseLayout.astro";

const tahun = [...new Set(capaian.map((c) => c.tahun))];
---

<BaseLayout title="Dampak" description="Capaian Komunitas Kertas Kosong dari tahun ke tahun: peserta bimbel, kelulusan SNBT, relawan, dan baju lebaran tersalurkan.">
  <PageHero eyebrow="Dampak" title="Hasil nyata dari langkah-langkah kecil" foto="seminar/seminar-2026-foto-bersama-lebar.jpg" fotoAlt="Foto bersama peserta Seminar Ayo Kuliah 2026">
    <p>
      Fokus kami adalah hasil nyata yang dirasakan individu, keluarga, dan masyarakat luas. Angka di halaman ini
      ditampilkan per tahun, karena angka kumulatif belum tersedia.
    </p>
  </PageHero>

  <section class="mx-auto max-w-6xl space-y-14 px-4 py-16 sm:px-6 sm:py-20">
    {
      tahun.map((t) => (
        <div class="grid gap-6 lg:grid-cols-[10rem_1fr]">
          <h2 class="text-4xl font-extrabold text-tinta-300">{t}</h2>
          <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {capaian
              .filter((c) => c.tahun === t)
              .map(({ capaian: label, angka }) => (
                <div class="rounded-2xl border border-tinta-100 bg-white p-5 shadow-sm">
                  <dt class="text-sm text-slate-600">{label}</dt>
                  <dd class="mt-1 text-2xl font-extrabold leading-tight text-tinta-700">{angka}</dd>
                </div>
              ))}
          </dl>
        </div>
      ))
    }
  </section>

  <section class="border-y border-tinta-100 bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center">
      <Foto
        src="bimbel/bimbel-2026-slide-progres-tryout.jpg"
        alt="Progres pembelajaran Bimbel Ayo Kuliah 2026: rerata tryout naik 6 persen"
        class="w-full rounded-2xl border border-tinta-100 shadow-md"
      />
      <div>
        <h2 class="text-3xl font-extrabold tracking-tight">Rerata tryout naik 6 persen</h2>
        <p class="mt-4 text-lg text-slate-600">
          Pada Bimbel Ayo Kuliah 2026, rerata skor tryout peserta naik dari 486,46 pada Tryout 1 menjadi 514,81 pada
          Tryout 2. Sebanyak 15 peserta tercatat lolos SNBT di 7 kampus.
        </p>
        <a href="/bimbel#hasil" class="tombol-kedua mt-6">Hasil per angkatan <Icon name="ArrowRight" class="size-4" /></a>
      </div>
    </div>
  </section>

  <AjakanTerlibat />
</BaseLayout>
