---
import FaqList from "../components/FaqList.astro";
import PageHero from "../components/PageHero.astro";
import PilihPeran from "../components/PilihPeran.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { faqTerlibat } from "../data/terlibat";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Ayo Terlibat" description="Jadi tentor relawan, fasilitator, peserta bimbel, donatur, atau mitra kolaborasi Komunitas Kertas Kosong.">
  <PageHero eyebrow="Ayo Terlibat" title="Satu langkah kecil untuk pendidikan" foto="relawan/silaturahmi-lebaran-2025.jpg" fotoAlt="Anggota dan relawan Komunitas Kertas Kosong berkumpul selepas Lebaran 2025">
    <p>Ada banyak cara untuk ikut bergerak bersama K3: mengajar, mendampingi, belajar, berdonasi, atau berkolaborasi.</p>
    <Fragment slot="actions">
      <a href="#peran" class="tombol-utama">Pilih peranmu</a>
    </Fragment>
  </PageHero>

  <PilihPeran />

  <section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-4 pb-20 sm:px-6">
    <SectionHeading eyebrow="FAQ" title="Pertanyaan yang sering diajukan" center />
    <div class="mt-10">
      <FaqList items={faqTerlibat} />
    </div>
  </section>
</BaseLayout>
