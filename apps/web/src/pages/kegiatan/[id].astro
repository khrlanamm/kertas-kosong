---
import type { GetStaticPaths } from "astro";
import { getImage, Image } from "astro:assets";
import { render } from "astro:content";
import Icon from "../../components/Icon.astro";
import StatusKegiatan from "../../components/StatusKegiatan.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { akhirKegiatan, formatWaktu, getKegiatan, labelJenis, type Kegiatan } from "../../lib/kegiatan";

export const getStaticPaths = (async () => {
  const semua = await getKegiatan();
  return semua.map((kegiatan) => ({ params: { id: kegiatan.id }, props: { kegiatan } }));
}) satisfies GetStaticPaths;

interface Props {
  kegiatan: Kegiatan;
}

const { kegiatan } = Astro.props;
const { judul, jenis, mulai, selesai, lokasi, ringkasan, poster, pendaftaran } = kegiatan.data;
const akhir = akhirKegiatan(kegiatan);
const { Content } = await render(kegiatan);
const ogImage = poster ? (await getImage({ src: poster, width: 1200, format: "jpeg" })).src : undefined;
---

<BaseLayout title={judul} description={ringkasan} image={ogImage} type="article">
  <article class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14">
    <a href="/kegiatan" class="inline-flex items-center gap-1.5 text-sm font-semibold text-tinta-700 hover:text-tinta-900">
      <Icon name="ArrowLeft" class="size-4" /> Semua kegiatan
    </a>

    <div class:list={["mt-6 grid gap-10", poster && "md:grid-cols-[1fr_1.2fr]"]}>
      {
        poster && (
          <Image src={poster} alt={`Poster ${judul}`} width={800} class="h-auto w-full rounded-2xl border border-tinta-100 shadow-sm" />
        )
      }
      <div>
        <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
          <span class="rounded-full bg-tinta-100 px-2.5 py-1 text-tinta-800">{labelJenis[jenis]}</span>
          <StatusKegiatan mulai={mulai} akhir={akhir} />
        </div>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">{judul}</h1>

        <dl class="mt-6 space-y-3 rounded-2xl border border-tinta-100 bg-white p-5 text-sm">
          <div class="flex gap-3">
            <Icon name="CalendarDays" class="size-5 shrink-0 text-tinta-500" />
            <div>
              <dt class="sr-only">Waktu</dt>
              <dd class="font-medium text-slate-800">{formatWaktu(mulai, selesai)}</dd>
            </div>
          </div>
          <div class="flex gap-3">
            <Icon name="MapPin" class="size-5 shrink-0 text-tinta-500" />
            <div>
              <dt class="sr-only">Lokasi</dt>
              <dd class="font-medium text-slate-800">{lokasi}</dd>
            </div>
          </div>
        </dl>

        {
          pendaftaran && (
            <a
              href={pendaftaran}
              target="_blank"
              rel="noopener noreferrer"
              class="tombol-utama mt-6"
              data-tutup-setelah={akhir.toISOString()}
            >
              Daftar sekarang <Icon name="ExternalLink" class="size-4" />
            </a>
          )
        }

        <div class="isi-artikel mt-8 text-slate-700">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // Sembunyikan tombol daftar bila kegiatan sudah lewat, walau situs belum di-build ulang.
  document.querySelectorAll<HTMLElement>("[data-tutup-setelah]").forEach((el) => {
    if (Date.now() > Date.parse(el.dataset.tutupSetelah ?? "")) el.remove();
  });
</script>
