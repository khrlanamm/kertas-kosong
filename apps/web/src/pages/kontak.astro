---
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const { email, instagram, linkedin, whatsapp } = site.social;
const kontak = [
  { icon: "Mail", label: "Email", isi: email, href: `mailto:${email}` },
  instagram && { icon: "AtSign", label: "Instagram", isi: "@komunitaskertaskosong", href: instagram },
  linkedin && { icon: "Briefcase", label: "LinkedIn", isi: "linkedin.com/company/komunitaskertaskosong", href: linkedin },
  whatsapp && { icon: "MessageCircle", label: "WhatsApp", isi: "Chat WhatsApp", href: whatsapp },
  { icon: "MapPin", label: "Lokasi", isi: site.lokasi },
].filter(Boolean) as { icon: "Mail" | "AtSign" | "Briefcase" | "MessageCircle" | "MapPin"; label: string; isi: string; href?: string }[];
---

<BaseLayout title="Kontak" description={`Hubungi ${site.name} lewat email ${email} atau Instagram @komunitaskertaskosong.`}>
  <PageHero eyebrow="Kontak" title="Kami percaya setiap mimpi berhak mendapatkan kesempatan untuk tumbuh">
    <p>Punya pertanyaan, ingin bergabung sebagai relawan, berdonasi, atau berkolaborasi? Hubungi kami.</p>
  </PageHero>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 sm:py-20">
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        kontak.map(({ icon, label, isi, href }) => (
          <li class="flex gap-4 rounded-2xl border border-tinta-100 bg-white p-6 shadow-sm">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-tinta-50 text-tinta-600">
              <Icon name={icon} class="size-6" />
            </span>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-tinta-600">{label}</p>
              {href ? (
                <a
                  href={href}
                  target={href.startsWith("http") ? "_blank" : undefined}
                  rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
                  class="mt-0.5 block break-words font-semibold text-tinta-950 hover:text-tinta-700"
                >
                  {isi}
                </a>
              ) : (
                <p class="mt-0.5 font-semibold text-tinta-950">{isi}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
