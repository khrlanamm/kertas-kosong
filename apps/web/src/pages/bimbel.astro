---
import FaqList from "../components/FaqList.astro";
import Foto from "../components/Foto.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import PortalSegera from "../components/PortalSegera.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SocialLinks from "../components/SocialLinks.astro";
import StatGrid from "../components/StatGrid.astro";
import { site } from "../config/site";
import { angkatan, caraKerja, faqBimbel, hasil, jangkauan2026, materi, pesertaBimbel } from "../data/bimbel";
import BaseLayout from "../layouts/BaseLayout.astro";

const baris = [
  ["Waktu", "waktu"],
  ["Bentuk", "bentuk"],
  ["Kelas", "kelas"],
  ["Peserta", "peserta"],
  ["Tentor", "tentor"],
  ["Fasilitator", "fasilitator"],
  ["Durasi per sesi", "durasi"],
] as const;
---

<BaseLayout
  title={site.bimbel.name}
  description={`${site.bimbel.name}: bimbingan belajar gratis persiapan UTBK-SNBT dari ${site.name}. Pada 2026 menjangkau 171 siswa dari 50 sekolah dan 15 kota.`}
>
  <PageHero
    eyebrow="#AyoKuliah"
    title={site.bimbel.name}
    foto="bimbel/bimbel-2025-kelas-online-papan-tulis.jpg"
    fotoAlt="Tentor menjelaskan soal di kelas daring Bimbel 2025"
  >
    <p>
      Bimbel <strong class="stabilo font-semibold text-tinta-950">gratis</strong> ini bertujuan meningkatkan minat kuliah
      dan membantu siswa mempersiapkan UTBK-SNBT secara optimal, dengan akses yang lebih baik terhadap materi, strategi
      pengerjaan soal, dan latihan intensif.
    </p>
    <Fragment slot="actions">
      <a href="#daftar" class="tombol-utama">Cara mendaftar <Icon name="ArrowRight" class="size-4" /></a>
      <a href="#faq" class="tombol-kedua">Pertanyaan umum</a>
    </Fragment>
  </PageHero>

  <!-- Jangkauan 2026 -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:items-center">
      <div>
        <SectionHeading eyebrow="Jangkauan 2026" title="Dari Lamongan ke berbagai kota di Indonesia" />
        <StatGrid items={jangkauan2026.ringkas} class="mt-8 grid-cols-3!" />
        <p class="mt-5 text-slate-600">{jangkauan2026.sebaran}</p>
      </div>
      <Foto
        src="bimbel/bimbel-2026-slide-jangkauan.jpg"
        alt="Slide jangkauan Bimbel Ayo Kuliah 2026: 171 siswa, 50 sekolah, 15 kota, beserta persebaran kota dan sekolah"
        sizes="(min-width: 1024px) 55vw, 100vw"
        class="w-full rounded-2xl border border-tinta-100 shadow-md"
      />
    </div>
  </section>

  <!-- Materi dan cara kerja -->
  <section class="border-y border-tinta-100 bg-white">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Materi" title="Tujuh materi UTBK-SNBT">
          Program dijalankan sekitar lima minggu menjelang UTBK.
        </SectionHeading>
        <ol class="mt-6 grid gap-2">
          {
            materi.map((m, i) => (
              <li class="flex items-center gap-3 rounded-xl bg-kertas px-4 py-3">
                <span class="grid size-7 shrink-0 place-items-center rounded-full bg-tinta-600 text-xs font-bold text-white">{i + 1}</span>
                <span class="font-medium text-slate-800">{m}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <SectionHeading eyebrow="Cara kerja" title="Lima minggu yang terstruktur" />
        <ul class="mt-6 space-y-3">
          {
            caraKerja.map((item) => (
              <li class="flex gap-3">
                <Icon name="ClipboardCheck" class="mt-0.5 size-5 shrink-0 text-tinta-500" />
                <span class="text-slate-700">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Per angkatan -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <SectionHeading eyebrow="Dari tahun ke tahun" title="Tiga angkatan terakhir" />
    <div class="mt-10 overflow-x-auto rounded-2xl border border-tinta-100">
      <table class="w-full min-w-[36rem] text-left text-sm">
        <thead class="bg-tinta-50 text-tinta-900">
          <tr>
            <th scope="col" class="px-4 py-3"><span class="sr-only">Keterangan</span></th>
            {angkatan.map(({ tahun }) => <th scope="col" class="px-4 py-3 text-base font-bold">{tahun}</th>)}
          </tr>
        </thead>
        <tbody class="divide-y divide-tinta-100 bg-white">
          {
            baris.map(([label, kunci]) => (
              <tr class="align-top">
                <th scope="row" class="px-4 py-3 font-semibold text-tinta-800">{label}</th>
                {angkatan.map((a) => (
                  <td class="px-4 py-3 text-slate-700">{a[kunci] ?? "-"}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h3 id="hasil" class="mt-14 text-2xl font-extrabold">Hasil yang tercatat</h3>
    <div class="mt-6 grid gap-5 lg:grid-cols-3">
      {
        hasil.map(({ tahun, isi }) => (
          <div class="rounded-2xl border border-tinta-100 bg-white p-6 shadow-sm">
            <p class="inline-block rounded-full bg-stabilo/70 px-3 py-0.5 text-sm font-bold text-tinta-950">{tahun}</p>
            <p class="mt-3 text-slate-700">{isi}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-slate-500">
      Angka kelulusan berasal dari pendataan alumni, sehingga kemungkinan belum mencakup semua peserta.
    </p>
  </section>

  <!-- Pendaftaran -->
  <section id="daftar" class="scroll-mt-20 border-y border-tinta-100 bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-tinta-500">Pendaftaran angkatan {site.bimbel.angkatan}</p>
        {
          site.links.pendaftaranBimbel ? (
            <>
              <h2 class="mt-2 text-3xl font-extrabold tracking-tight">Pendaftaran sudah dibuka</h2>
              <p class="mt-3 text-lg text-slate-600">{pesertaBimbel.jadwal}</p>
              <a href={site.links.pendaftaranBimbel} target="_blank" rel="noopener noreferrer" class="tombol-utama mt-6">
                Daftar sekarang <Icon name="ExternalLink" class="size-4" />
              </a>
            </>
          ) : (
            <>
              <h2 class="mt-2 text-3xl font-extrabold tracking-tight">Pendaftaran belum dibuka</h2>
              <p class="mt-3 text-lg text-slate-600">{pesertaBimbel.jadwal}</p>
              <p class="mt-3 text-slate-600">Pengumumannya disampaikan lewat Instagram @komunitaskertaskosong.</p>
              <SocialLinks class="mt-6" />
            </>
          )
        }
        <h3 class="mt-10 font-bold text-tinta-950">Sasaran</h3>
        <p class="mt-1 text-slate-700">{pesertaBimbel.sasaran}</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <div class="rounded-2xl bg-kertas p-6">
          <h3 class="font-bold text-tinta-950">Syarat umum</h3>
          <ul class="mt-3 space-y-2 text-slate-700">
            {pesertaBimbel.syarat.map((s) => <li class="flex gap-2"><Icon name="ClipboardCheck" class="mt-0.5 size-4 shrink-0 text-tinta-500" />{s}</li>)}
          </ul>
        </div>
        <div class="rounded-2xl bg-kertas p-6">
          <h3 class="font-bold text-tinta-950">Yang didapat</h3>
          <ul class="mt-3 space-y-2 text-slate-700">
            {pesertaBimbel.didapat.map((s) => <li class="flex gap-2"><Icon name="Sparkles" class="mt-0.5 size-4 shrink-0 text-tinta-500" />{s}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-4 py-16 sm:px-6 sm:py-20">
    <SectionHeading eyebrow="FAQ" title="Pertanyaan umum" center />
    <div class="mt-10">
      <FaqList items={faqBimbel} />
    </div>
  </section>

  <PortalSegera />
</BaseLayout>
