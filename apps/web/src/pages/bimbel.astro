---
import FaqList from "../components/FaqList.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import PetaJangkauan from "../components/PetaJangkauan.astro";
import Pita from "../components/Pita.astro";
import PortalSegera from "../components/PortalSegera.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SocialLinks from "../components/SocialLinks.astro";
import StatGrid from "../components/StatGrid.astro";
import VideoLoop from "../components/VideoLoop.astro";
import { site } from "../config/site";
import { alurLimaMinggu, angkatan, caraKerja, faqBimbel, hasil, jangkauan2026, kampusLolos, materi, pesertaBimbel } from "../data/bimbel";
import BaseLayout from "../layouts/BaseLayout.astro";

const baris = [
  ["Waktu", "waktu"],
  ["Bentuk", "bentuk"],
  ["Kelas", "kelas"],
  ["Peserta", "peserta"],
  ["Tentor", "tentor"],
  ["Fasilitator", "fasilitator"],
  ["Durasi per sesi", "durasi"],
] as const;

const kampus = kampusLolos.map(({ kampus, jumlah, tahun }) => `${kampus} ${jumlah}, ${tahun}`);
---

<BaseLayout
  title={site.bimbel.name}
  description={`${site.bimbel.name}: bimbingan belajar gratis persiapan UTBK-SNBT dari ${site.name}. Pada 2026 menjangkau 171 siswa dari 50 sekolah dan 15 kota.`}
>
  <PageHero
    eyebrow="#AyoKuliah"
    title={site.bimbel.name}
    foto="bimbel/bimbel-2024-kelas-luring.jpg"
    fotoAlt="Suasana kelas luring Bimbel 2024 di SMAN 1 Sukodadi"
  >
    <p>
      Bimbel <strong class="stabilo font-semibold text-tinta-950">gratis</strong> ini bertujuan meningkatkan minat kuliah
      dan membantu siswa mempersiapkan UTBK-SNBT secara optimal, dengan akses yang lebih baik terhadap materi, strategi
      pengerjaan soal, dan latihan intensif.
    </p>
    <Fragment slot="actions">
      <a href="#daftar" class="tombol-utama">Cara mendaftar <Icon name="ArrowRight" class="size-4" /></a>
      <a href="#faq" class="tombol-kedua">Pertanyaan umum</a>
    </Fragment>
  </PageHero>

  <!-- Jangkauan 2026 -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:items-center">
      <div>
        <SectionHeading eyebrow="Jangkauan 2026" title="Dari Lamongan ke berbagai kota di Indonesia" />
        <StatGrid items={jangkauan2026.ringkas} class="mt-8 grid-cols-3!" />
        <p class="mt-5 text-slate-600">{jangkauan2026.sebaran}</p>
      </div>
      <PetaJangkauan />
    </div>
  </section>

  <!-- Suasana kelas -->
  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20">
    <VideoLoop src="kelas-luring-2024.mp4" poster="bimbel/bimbel-2024-kelas-luring.jpg" ket="Kelas luring, 2024" alt="Video pendek suasana kelas luring Bimbel 2024" />
  </section>

  <!-- Materi dan cara kerja -->
  <section class="border-y border-tinta-100 bg-white">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Materi" title="Tujuh materi UTBK-SNBT">
          Program dijalankan sekitar lima minggu menjelang UTBK.
        </SectionHeading>
        <ol data-urut class="mt-6 grid gap-2">
          {
            materi.map((m, i) => (
              <li class="flex items-center gap-3 rounded-xl bg-kertas px-4 py-3">
                <span class="grid size-7 shrink-0 place-items-center rounded-full bg-tinta-600 text-xs font-bold text-white">{i + 1}</span>
                <span class="font-medium text-slate-800">{m}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <SectionHeading eyebrow="Cara kerja" title="Lima minggu yang terstruktur" />
        <div role="tablist" aria-label="Alur program" class="mt-6 flex gap-1.5">
          {
            alurLimaMinggu.map(({ judul, lebar }, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-minggu-${i}`}
                aria-controls={`panel-minggu-${i}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="langkah-minggu"
                style={`flex-grow:${lebar}`}
              >
                {judul}
              </button>
            ))
          }
        </div>
        {
          alurLimaMinggu.map(({ isi }, i) => (
            <div role="tabpanel" id={`panel-minggu-${i}`} aria-labelledby={`tab-minggu-${i}`} class:list={["mt-3 rounded-xl bg-kertas p-4 text-slate-700", i === 0 && "aktif"]}>
              {isi}
            </div>
          ))
        }
        <ul class="mt-6 space-y-3">
          {
            caraKerja
              .filter((item) => !item.startsWith("Minggu 1") && !item.startsWith("Program ditutup"))
              .map((item) => (
                <li class="flex gap-3">
                  <Icon name="ClipboardCheck" class="mt-0.5 size-5 shrink-0 text-tinta-500" />
                  <span class="text-slate-700">{item}</span>
                </li>
              ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Per angkatan -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <SectionHeading eyebrow="Dari tahun ke tahun" title="Tiga angkatan terakhir" />
    <div role="tablist" aria-label="Pilih angkatan" class="mt-8 flex gap-2">
      {
        angkatan.map(({ tahun }, i) => (
          <button type="button" role="tab" id={`tab-angkatan-${tahun}`} aria-controls={`panel-angkatan-${tahun}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} class="pilih-tahun">
            {tahun}
          </button>
        ))
      }
    </div>
    {
      angkatan.map((a, i) => (
        <div role="tabpanel" id={`panel-angkatan-${a.tahun}`} aria-labelledby={`tab-angkatan-${a.tahun}`} class:list={["mt-4", i === 0 && "aktif"]}>
          <h3 class="sr-only">Angkatan {a.tahun}</h3>
          <dl class="grid gap-px overflow-hidden rounded-2xl border border-tinta-100 bg-tinta-100 sm:grid-cols-2 lg:grid-cols-3">
            {baris.map(([label, kunci]) => (
              <div class="bg-white p-4 last:col-span-full">
                <dt class="text-sm text-slate-500">{label}</dt>
                <dd class="mt-0.5 font-semibold text-tinta-900">{a[kunci] ?? "Belum terdata"}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))
    }

    <h3 id="hasil" class="mt-14 scroll-mt-24 text-2xl font-extrabold">Hasil yang tercatat</h3>
    <div class="mt-5 rounded-xl bg-tinta-700 py-2.5 text-white">
      <Pita items={kampus} class="tulisan text-2xl leading-none" />
    </div>
    <div data-urut class="mt-6 grid gap-5 lg:grid-cols-3">
      {
        hasil.map(({ tahun, isi }) => (
          <div class="rounded-2xl border border-tinta-100 bg-white p-6 shadow-sm">
            <p class="inline-block rounded-full bg-stabilo/70 px-3 py-0.5 text-sm font-bold text-tinta-950">{tahun}</p>
            <p class="mt-3 text-slate-700">{isi}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-slate-500">
      Angka kelulusan berasal dari pendataan alumni, sehingga kemungkinan belum mencakup semua peserta.
    </p>
  </section>

  <!-- Pendaftaran -->
  <section id="daftar" class="scroll-mt-20 border-y border-tinta-100 bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-tinta-600">Pendaftaran angkatan {site.bimbel.angkatan}</p>
        {
          site.links.pendaftaranBimbel ? (
            <>
              <h2 class="mt-2 text-3xl font-extrabold tracking-tight">Pendaftaran sudah dibuka</h2>
              <p class="mt-3 text-lg text-slate-600">{pesertaBimbel.jadwal}</p>
              <a href={site.links.pendaftaranBimbel} target="_blank" rel="noopener noreferrer" class="tombol-utama mt-6">
                Daftar sekarang <Icon name="ExternalLink" class="size-4" />
              </a>
            </>
          ) : (
            <>
              <h2 class="mt-2 text-3xl font-extrabold tracking-tight">Pendaftaran belum dibuka</h2>
              <p class="mt-3 text-lg text-slate-600">{pesertaBimbel.jadwal}</p>
              <p class="mt-3 text-slate-600">Pengumumannya disampaikan lewat Instagram @komunitaskertaskosong.</p>
              <SocialLinks class="mt-6" />
            </>
          )
        }
        <h3 class="mt-10 font-bold text-tinta-950">Sasaran</h3>
        <p class="mt-1 text-slate-700">{pesertaBimbel.sasaran}</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <div class="rounded-2xl bg-kertas p-6">
          <h3 class="font-bold text-tinta-950">Syarat umum</h3>
          <ul class="mt-3 space-y-2 text-slate-700">
            {pesertaBimbel.syarat.map((s) => <li class="flex gap-2"><Icon name="ClipboardCheck" class="mt-0.5 size-4 shrink-0 text-tinta-500" />{s}</li>)}
          </ul>
        </div>
        <div class="rounded-2xl bg-kertas p-6">
          <h3 class="font-bold text-tinta-950">Yang didapat</h3>
          <ul class="mt-3 space-y-2 text-slate-700">
            {pesertaBimbel.didapat.map((s) => <li class="flex gap-2"><Icon name="Sparkles" class="mt-0.5 size-4 shrink-0 text-tinta-500" />{s}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-4 py-16 sm:px-6 sm:py-20">
    <SectionHeading eyebrow="FAQ" title="Pertanyaan umum" center />
    <div class="mt-10">
      <FaqList items={faqBimbel} />
    </div>
  </section>

  <PortalSegera />
</BaseLayout>

<style is:global>
  .langkah-minggu {
    min-width: max-content;
    flex-basis: 0;
    cursor: pointer;
    border-radius: 0.5rem;
    background: var(--color-tinta-100);
    color: var(--color-tinta-800);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.55rem 0.6rem;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .langkah-minggu[aria-selected="true"] {
    background: var(--color-tinta-700);
    color: white;
  }
  .pilih-tahun {
    cursor: pointer;
    border: 1px solid var(--color-tinta-200);
    border-radius: 9999px;
    background: white;
    color: var(--color-tinta-800);
    font-weight: 700;
    padding: 0.35rem 1.1rem;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .pilih-tahun[aria-selected="true"] {
    border-color: var(--color-tinta-700);
    background: var(--color-tinta-700);
    color: white;
  }
  html:not(.js) [role="tablist"]:has(.pilih-tahun, .langkah-minggu) {
    display: none;
  }
</style>

<script>
  import "../scripts/tab";
</script>
