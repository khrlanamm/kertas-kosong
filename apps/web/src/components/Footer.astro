---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { nav, site } from "../config/site";
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-tinta-100 bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="space-y-4">
      <Image src={logo} alt="Logo Komunitas Kertas Kosong" width={360} class="h-auto w-44" />
      <p class="max-w-sm text-sm leading-relaxed text-slate-600">{site.description}</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-tinta-700">Jelajahi</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={href} class="text-slate-600 hover:text-tinta-800">
                {label}
              </a>
            </li>
          ))
        }
        {
          site.links.portal && (
            <li>
              <a href={site.links.portal} class="text-slate-600 hover:text-tinta-800">
                Portal Bimbel
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-tinta-700">Ikuti kami</h2>
      <SocialLinks class="mt-4" />
      <p class="mt-4 text-sm text-slate-600">
        Pengumuman pendaftaran bimbel dan kegiatan disampaikan melalui media sosial komunitas.
      </p>
    </div>
  </div>
  <div class="border-t border-tinta-100">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-slate-500 sm:px-6">
      &copy; {year} {site.name}
    </p>
  </div>
</footer>
