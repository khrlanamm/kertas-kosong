---
import { Image } from "astro:assets";
import kertas from "../assets/kertas.png";
---

<a href="/" class="flex items-center gap-2.5" aria-label="Komunitas Kertas Kosong, ke beranda">
  <Image src={kertas} alt="" width={88} class="h-auto w-11" loading="eager" />
  <span class="leading-none">
    <span class="block text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-tinta-500">Komunitas</span>
    <span class="block text-lg font-extrabold tracking-tight text-tinta-700">Kertas Kosong</span>
  </span>
</a>
