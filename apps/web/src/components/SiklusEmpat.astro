---
import { gerakan } from "../data/program";
import Icon from "./Icon.astro";
import Ilustrasi from "./Ilustrasi.astro";
---

<div class="mt-10 grid gap-5 lg:grid-cols-[17rem_1fr]" data-muncul>
  <div role="tablist" aria-label="Empat gerakan #4AYO" aria-orientation="vertical" class="grid grid-cols-2 gap-2 lg:grid-cols-1">
    {
      gerakan.map(({ slug, nama }, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${slug}`}
          aria-controls={`panel-${slug}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          class="pembatas"
        >
          <span class="tulisan text-2xl leading-none text-tinta-500">{i + 1}</span>
          <span class="font-bold">{nama}</span>
        </button>
      ))
    }
  </div>

  <div class="relative min-w-0 rounded-2xl border border-tinta-100 bg-kertas garis-buku shadow-sm">
    {
      gerakan.map(({ slug, nama, ringkas, ilustrasi }, i) => (
        <div role="tabpanel" id={`panel-${slug}`} aria-labelledby={`tab-${slug}`} class:list={["grid items-center gap-4 p-6 sm:grid-cols-[1fr_15rem] sm:p-10", i === 0 && "aktif"]}>
          <div>
            <p class="tulisan text-xl text-tinta-600">Pilar {i + 1} dari 4</p>
            <h3 class="mt-1 text-3xl font-extrabold">{nama}</h3>
            <p class="mt-3 text-lg leading-relaxed text-slate-600">{ringkas}</p>
            <a href={`/program/${slug}`} class="tombol-utama mt-6">
              Selengkapnya <Icon name="ArrowRight" class="size-4" />
            </a>
          </div>
          <Ilustrasi nama={ilustrasi} class="mx-auto w-44 sm:w-full" />
        </div>
      ))
    }
  </div>
</div>

<p class="mt-6 flex items-center gap-3 text-tinta-700" data-muncul>
  <Icon name="RefreshCw" class="size-5 shrink-0 text-tinta-400" />
  <span class="tulisan text-2xl leading-tight">Mereka yang dulu didampingi kini mendampingi. Siklus inilah yang membuat gerakan terus berjalan.</span>
</p>

<style>
  .pembatas {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    border: 1px solid var(--color-tinta-100);
    border-radius: 0.875rem;
    background: white;
    color: var(--color-tinta-900);
    padding: 0.8rem 1rem;
    text-align: left;
    transition:
      background-color 0.25s,
      border-color 0.25s,
      translate 0.25s var(--ease-kertas);
  }
  .pembatas:hover {
    background: var(--color-tinta-50);
  }
  .pembatas[aria-selected="true"] {
    border-color: var(--color-tinta-700);
    background: var(--color-tinta-700);
    color: white;
  }
  .pembatas[aria-selected="true"] span:first-child {
    color: var(--color-stabilo);
  }
  @media (min-width: 64rem) {
    .pembatas[aria-selected="true"] {
      translate: 0.5rem 0;
    }
  }
</style>

<script>
  import "../scripts/tab";
</script>
