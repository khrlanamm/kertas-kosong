---
import Foto from "./Foto.astro";
import Ilustrasi from "./Ilustrasi.astro";

interface Props {
  eyebrow?: string;
  title: string;
  /** Foto di sisi kanan (path di src/assets/foto/). */
  foto?: string;
  fotoAlt?: string;
  /** Pengganti foto untuk pilar yang belum punya dokumentasi. */
  ilustrasi?: "baca" | "tulis" | "kuliah" | "berbagi";
}

const { eyebrow, title, foto, fotoAlt = "", ilustrasi } = Astro.props;
const berkolom = foto || ilustrasi;
---

<section class="garis-buku overflow-hidden border-b border-tinta-100">
  <div class:list={["mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20", berkolom && "grid items-center gap-10 lg:grid-cols-[1.2fr_1fr]"]}>
    <div>
      {eyebrow && <p data-muncul class="text-sm font-semibold uppercase tracking-[0.18em] text-tinta-600">{eyebrow}</p>}
      <h1 data-muncul style="--jeda:70ms" class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
      <div data-muncul style="--jeda:140ms" class="mt-5 max-w-2xl space-y-4 text-lg leading-relaxed text-slate-600">
        <slot />
      </div>
      {
        Astro.slots.has("actions") && (
          <div data-muncul style="--jeda:210ms" class="mt-8 flex flex-wrap gap-3">
            <slot name="actions" />
          </div>
        )
      }
    </div>
    {
      foto && (
        <div data-muncul="skala" style="--jeda:120ms" class="geser-lembut">
          <div class="bingkai-foto selotip relative rotate-1">
            <Foto src={foto} alt={fotoAlt} prioritas sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[4/3] w-full object-cover" />
          </div>
        </div>
      )
    }
    {ilustrasi && <Ilustrasi nama={ilustrasi} class="mx-auto w-64 lg:w-80" />}
  </div>
</section>
