---
interface Props {
  eyebrow?: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="garis-buku border-b border-tinta-100">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.18em] text-tinta-500">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
    <div class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">
      <slot />
    </div>
    {
      Astro.slots.has("actions") && (
        <div class="mt-8 flex flex-wrap gap-3">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
