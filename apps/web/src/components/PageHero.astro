---
import Foto from "./Foto.astro";

interface Props {
  eyebrow?: string;
  title: string;
  /** Foto di sisi kanan (path di src/assets/foto/). */
  foto?: string;
  fotoAlt?: string;
}

const { eyebrow, title, foto, fotoAlt = "" } = Astro.props;
---

<section class="garis-buku border-b border-tinta-100">
  <div class:list={["mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20", foto && "grid items-center gap-10 lg:grid-cols-[1.2fr_1fr]"]}>
    <div>
      {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.18em] text-tinta-500">{eyebrow}</p>}
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
      <div class="mt-5 max-w-2xl space-y-4 text-lg leading-relaxed text-slate-600">
        <slot />
      </div>
      {
        Astro.slots.has("actions") && (
          <div class="mt-8 flex flex-wrap gap-3">
            <slot name="actions" />
          </div>
        )
      }
    </div>
    {
      foto && (
        <Foto
          src={foto}
          alt={fotoAlt}
          loading="eager"
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="aspect-[4/3] w-full rotate-1 rounded-2xl border-4 border-white object-cover shadow-xl"
        />
      )
    }
  </div>
</section>
