---
import { Image } from "astro:assets";
import { foto } from "../lib/foto";

interface Props {
  /** Path di src/assets/foto/, mis. "seminar/seminar-2026-foto-bersama-aula.jpg". */
  src: string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  /** true untuk gambar terbesar di layar pertama, supaya dimuat paling awal. */
  prioritas?: boolean;
  [atribut: `data-${string}`]: unknown;
}

const {
  src,
  alt,
  class: className,
  widths = [480, 800, 1200],
  sizes = "(min-width: 1024px) 50vw, 100vw",
  loading = "lazy",
  prioritas = false,
  ...lainnya
} = Astro.props;
---

<Image
  src={foto(src)}
  alt={alt}
  widths={widths}
  sizes={sizes}
  loading={prioritas ? "eager" : loading}
  fetchpriority={prioritas ? "high" : undefined}
  class={className}
  {...lainnya}
/>
