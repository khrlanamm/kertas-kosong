---
import { capaianBerbagi } from "../data/program";

const kolom = 50;
const baris = 20;
const sel = 16;
const terbaru = capaianBerbagi[capaianBerbagi.length - 1];
const penuh = Math.floor(terbaru.jumlah / kolom);
const sisa = terbaru.jumlah % kolom;
const ikon = "M5.5 2.5 2.5 4.6 3.9 7 5 6.5V13.5H11V6.5L12.1 7 13.5 4.6 10.5 2.5C10 3.5 9.2 4 8 4S6 3.5 5.5 2.5Z";
---

<div data-baju class="rounded-2xl border border-tinta-100 bg-white p-5 sm:p-7" data-muncul>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div aria-live="polite">
      <p class="text-5xl font-extrabold tabular-nums tracking-tight text-tinta-800">
        <span data-baju-angka>{terbaru.jumlah}</span>
        <span class="text-2xl font-bold text-slate-500">/ 1000</span>
      </p>
      <p class="mt-1 text-slate-600"><span data-baju-teks>{terbaru.isi}</span> pada <span data-baju-tahun>{terbaru.tahun}</span></p>
    </div>
    <div class="flex gap-1.5" role="group" aria-label="Pilih tahun">
      {
        capaianBerbagi.map(({ tahun, jumlah, isi }, i) => (
          <button type="button" class="baju-tahun" data-tahun={tahun} data-jumlah={jumlah} data-isi={isi} aria-pressed={i === capaianBerbagi.length - 1 ? "true" : "false"}>
            {tahun}
          </button>
        ))
      }
    </div>
  </div>

  <svg viewBox={`0 0 ${kolom * sel} ${baris * sel}`} class="mt-5 block h-auto w-full" role="img" aria-label="Seribu ikon baju. Bagian yang berwarna menunjukkan capaian tahun terpilih.">
    <defs>
      <pattern id="pola-kosong" width={sel} height={sel} patternUnits="userSpaceOnUse">
        <path d={ikon} fill="var(--color-tinta-100)" />
      </pattern>
      <pattern id="pola-isi" width={sel} height={sel} patternUnits="userSpaceOnUse">
        <path d={ikon} fill="var(--color-tinta-700)" />
      </pattern>
      <clipPath id="klip-baju">
        <rect data-baju-penuh x="0" y="0" width={kolom * sel} height={penuh * sel} />
        <rect data-baju-sisa x="0" y={penuh * sel} width={sisa * sel} height={sel} />
      </clipPath>
    </defs>
    <rect width={kolom * sel} height={baris * sel} fill="url(#pola-kosong)" />
    <rect width={kolom * sel} height={baris * sel} fill="url(#pola-isi)" clip-path="url(#klip-baju)" />
  </svg>
  <p class="mt-3 text-sm text-slate-500">
    Angka 1000 adalah cita-cita gerakan, dan setiap tahun kami berusaha mendekatinya. Satuan mengikuti catatan tahun itu, per anak atau per baju. Tahun lain belum terdata.
  </p>
</div>

<style>
  .baju-tahun {
    cursor: pointer;
    border: 1px solid var(--color-tinta-200);
    border-radius: 9999px;
    background: white;
    color: var(--color-tinta-800);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.3rem 0.8rem;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .baju-tahun[aria-pressed="true"] {
    border-color: var(--color-tinta-700);
    background: var(--color-tinta-700);
    color: white;
  }
</style>

<script>
  const KOLOM = 50;
  const SEL = 16;
  const kurangiGerak = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-baju]").forEach((akar) => {
    const penuh = akar.querySelector("[data-baju-penuh]");
    const sisa = akar.querySelector("[data-baju-sisa]");
    const angka = akar.querySelector("[data-baju-angka]");
    const teks = akar.querySelector("[data-baju-teks]");
    const tahun = akar.querySelector("[data-baju-tahun]");
    const tombol = [...akar.querySelectorAll<HTMLButtonElement>("[data-tahun]")];

    const gambar = (n: number) => {
      const baris = Math.floor(n / KOLOM);
      penuh?.setAttribute("height", String(baris * SEL));
      sisa?.setAttribute("y", String(baris * SEL));
      sisa?.setAttribute("width", String((n % KOLOM) * SEL));
      if (angka) angka.textContent = String(n);
    };

    let sekarang = 0;
    let bingkai = 0;
    const menuju = (tujuan: number) => {
      cancelAnimationFrame(bingkai);
      if (kurangiGerak) {
        sekarang = tujuan;
        gambar(tujuan);
        return;
      }
      const dari = sekarang;
      let mulai = 0;
      const langkah = (waktu: number) => {
        mulai ||= waktu;
        const t = Math.min((waktu - mulai) / 900, 1);
        sekarang = Math.round(dari + (tujuan - dari) * (1 - (1 - t) ** 3));
        gambar(sekarang);
        if (t < 1) bingkai = requestAnimationFrame(langkah);
      };
      bingkai = requestAnimationFrame(langkah);
    };

    tombol.forEach((b) => {
      b.addEventListener("click", () => {
        tombol.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        if (teks) teks.textContent = b.dataset.isi ?? "";
        if (tahun) tahun.textContent = b.dataset.tahun ?? "";
        menuju(Number(b.dataset.jumlah));
      });
    });

    const awal = Number(tombol[tombol.length - 1]?.dataset.jumlah ?? 0);
    gambar(0);
    new IntersectionObserver(
      ([e], p) => {
        if (!e.isIntersecting) return;
        p.disconnect();
        menuju(awal);
      },
      { threshold: 0.3 },
    ).observe(akar);
  });
</script>
