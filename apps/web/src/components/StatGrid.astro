---
interface Props {
  items: readonly { angka: string; label: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<dl class:list={["grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-tinta-100 bg-tinta-100 sm:grid-cols-3", className]}>
  {
    items.map(({ angka, label }) => (
      <div class="flex flex-col-reverse bg-white p-5">
        <dt class="mt-1 text-sm leading-snug text-slate-600">{label}</dt>
        <dd class="text-3xl font-extrabold tracking-tight text-tinta-700 sm:text-4xl">{angka}</dd>
      </div>
    ))
  }
</dl>
