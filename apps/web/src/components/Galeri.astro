---
import { getImage, Image } from "astro:assets";
import type { Album } from "../data/galeri";
import { foto } from "../lib/foto";

interface Props {
  album: Album[];
}

const { album } = Astro.props;

const semua = album.flatMap((a) => a.foto.map((item) => ({ ...item, albumId: a.id, albumJudul: a.judul })));

const daftar = await Promise.all(
  semua.map(async (item) => {
    const img = foto(item.foto);
    const besar = await getImage({ src: img, width: Math.min(1600, img.width), format: "webp" });
    const kecil = await getImage({ src: img, width: 160, format: "webp" });
    const id = item.foto.split("/").pop()?.replace(/\.\w+$/, "");
    return { ...item, img, besar: besar.src, kecil: kecil.src, id };
  }),
);
---

<ul data-galeri class="columns-2 gap-3 sm:columns-3 lg:columns-4">
  {
    daftar.map(({ img, besar, kecil, ket, id, albumId, albumJudul, tahun }, i) => (
      <li class="mb-3 break-inside-avoid" data-album={albumId} data-tahun={tahun ?? ""} data-muncul style={`--jeda:${Math.min(i % 8, 7) * 40}ms`}>
        <button
          type="button"
          data-lightbox
          data-src={besar}
          data-kecil={kecil}
          data-ket={ket}
          data-sub={[albumJudul, tahun].filter(Boolean).join(", ")}
          data-id={id}
          class="group relative block w-full cursor-zoom-in overflow-hidden rounded-xl bg-tinta-100 shadow-sm"
          aria-label={`Perbesar foto: ${ket}`}
        >
          <Image
            src={img}
            alt={ket}
            widths={[320, 640]}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
            class="h-auto w-full transition duration-500 ease-kertas group-hover:scale-[1.04]"
          />
          <span class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-2 bg-gradient-to-t from-tinta-950/80 to-transparent p-3 pt-8 text-left text-sm font-medium leading-snug text-white opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
            {ket}
          </span>
        </button>
      </li>
    ))
  }
</ul>
