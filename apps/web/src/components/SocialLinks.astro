---
import { siInstagram, siTiktok, siWhatsapp, siYoutube } from "simple-icons";
import { site } from "../config/site";
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const { instagram, linkedin, youtube, tiktok, whatsapp, email } = site.social;

const bulat =
  "grid size-10 place-items-center rounded-full border border-tinta-100 bg-white text-tinta-700 transition-colors hover:border-tinta-300 hover:text-tinta-900";

const brands = [
  { href: instagram, label: "Instagram", path: siInstagram.path },
  { href: youtube, label: "YouTube", path: siYoutube.path },
  { href: tiktok, label: "TikTok", path: siTiktok.path },
  { href: whatsapp, label: "WhatsApp", path: siWhatsapp.path },
].filter((item) => item.href);
---

<ul class:list={["flex flex-wrap items-center gap-2", className]}>
  {
    brands.map(({ href, label, path }) => (
      <li>
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} class={bulat}>
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
            <path d={path} />
          </svg>
        </a>
      </li>
    ))
  }
  {
    linkedin && (
      <li>
        <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class={bulat}>
          <span class="text-sm font-extrabold leading-none" aria-hidden="true">in</span>
        </a>
      </li>
    )
  }
  {
    email && (
      <li>
        <a href={`mailto:${email}`} aria-label="Email" class={bulat}>
          <Icon name="Mail" class="size-4" />
        </a>
      </li>
    )
  }
</ul>
