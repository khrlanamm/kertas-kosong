---
import { Image } from "astro:assets";
import { foto } from "../lib/foto";

interface Props {
  /** Awalan id, harus unik dalam satu halaman. */
  id: string;
  layar: readonly { foto: string; label: string; alt: string }[];
  class?: string;
}

const { id, layar, class: className } = Astro.props;
---

<div data-muncul="skala" class:list={["flex flex-col items-center gap-4", className]}>
  <div class="hp">
    {
      layar.map(({ foto: src, alt }, i) => (
        <div role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`} class:list={["hp-layar", i === 0 && "aktif"]}>
          <Image src={foto(src)} alt={alt} widths={[240, 480]} sizes="16rem" class="block h-auto w-full" />
        </div>
      ))
    }
  </div>
  <div role="tablist" aria-label="Pilih layar" class="flex flex-wrap justify-center gap-1.5">
    {
      layar.map(({ label }, i) => (
        <button type="button" role="tab" id={`${id}-tab-${i}`} aria-controls={`${id}-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} class="hp-tab">
          {label}
        </button>
      ))
    }
  </div>
</div>

<style>
  .hp {
    width: min(15rem, 70vw);
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--color-tinta-950);
    box-shadow: 0 24px 40px -22px rgb(19 38 47 / 0.6);
  }
  .hp-tab {
    cursor: pointer;
    border: 1px solid var(--color-tinta-200);
    border-radius: 9999px;
    background: white;
    color: var(--color-tinta-800);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.3rem 0.85rem;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .hp-tab[aria-selected="true"] {
    border-color: var(--color-tinta-700);
    background: var(--color-tinta-700);
    color: white;
  }
  :global(html:not(.js)) [role="tablist"]:has(.hp-tab) {
    display: none;
  }
</style>

<script>
  import "../scripts/tab";
</script>
