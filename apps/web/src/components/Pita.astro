---
interface Props {
  items: readonly string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class:list={["pita", className]}>
  <ul class="pita-isi">
    {items.map((t) => <li class="whitespace-nowrap">{t}</li>)}
  </ul>
  <ul class="pita-isi" aria-hidden="true">
    {items.map((t) => <li class="whitespace-nowrap">{t}</li>)}
  </ul>
</div>
